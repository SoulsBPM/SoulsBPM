# Copie este arquivo para ".env" (mesmo nome, sem ".exemplo") e cole suas chaves depois do "=".
# Nunca suba o .env para o Git.

# Obrigatórias
LASTFM_API_KEY=
GETSONGBPM_API_KEY=

# Opcional: liga a IA (interpretar a vibe, sugerir artistas, explicar a transição e embeddings).
# Basta uma. A do Gemini é gratuita e liga tudo de uma vez.
GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=

# Opcional: recuperação de senha por e-mail (o cadastro pede nome, e-mail e senha).
# Usa o Brevo por API (o Render grátis bloqueia SMTP). Crie a conta no Brevo, valide um e-mail remetente e gere a chave da API.
BREVO_API_KEY=
EMAIL_REMETENTE=
# EMAIL_REMETENTE_NOME=SoulsBPM
# Endereço público do site, usado no link do e-mail. No Render: https://SEU-APP.onrender.com
SOULSBPM_URL=
# Só para testar no seu computador sem enviar e-mail: mostra o link de redefinição no terminal.
# EMAIL_MODO=console
